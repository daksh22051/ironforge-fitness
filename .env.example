# ==============================================================================
# IRONFORGE FITNESS — PRODUCTION ENVIRONMENT CONFIGURATION TEMPLATE
# Copy to .env and configure for local development or production deployment
# ==============================================================================

# Server Environment
PORT=3000
NODE_ENV=development

# Database Configuration
# Leave empty for local SQLite (data/ironforge.db), or provide PostgreSQL connection string:
# Example: postgres://username:password@hostname:5432/ironforge_db?sslmode=require
DATABASE_URL=

# Admin Dashboard Credentials
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=CHANGE_THIS_TO_A_STRONG_PASSWORD

# Cryptographic Session Secret (Min 32 random characters)
SESSION_SECRET=GENERATE_A_LONG_RANDOM_SECRET

# CORS Configuration for Separate Frontend/Backend Deployment (e.g., Vercel frontend)
# Example: https://ironforgefitness.com or https://your-site.vercel.app
FRONTEND_URL=
